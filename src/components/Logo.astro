---
// The mark, in one place. The comp draws it inline at two sizes; this keeps the
// path in a single file so replacing the logo later is a one-file change.
interface Props {
  size?: 'nav' | 'foot';
}
const { size = 'nav' } = Astro.props;
const dims = size === 'foot' ? { w: 28, h: 25 } : { w: 20, h: 18 };
---

<svg width={dims.w} height={dims.h} viewBox="0 0 20 18" aria-hidden="true">
  <path d="M10 0 L20 18 L0 18 Z" fill="#0d9488"></path>
</svg>
